# Variáveis de ambiente para AWS Amplify

# 🔐 Configurações AWS (não commitar valores reais)
AWS_REGION=us-east-1
AWS_APP_ID=your-amplify-app-id-here

# 🏗️ Configurações de Build
NODE_ENV=production
CI=true

# 🌐 Configurações da aplicação
VITE_API_URL=https://your-api-url.com
VITE_APP_NAME=Plataforma de Cobrança
VITE_APP_TITLE=Plataforma de Cobrança
VITE_APP_LOGO=/icon-192x192.png
VITE_APP_VERSION=1.0.0

# 📊 Analytics e monitoramento (opcional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# 🔗 URLs e domínios
VITE_BASE_URL=https://your-app.amplifyapp.com